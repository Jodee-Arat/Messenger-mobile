{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.jodeearat.ru",
        "EXPO_PUBLIC_SERVER_URL": "https://api.jodeearat.ru/graphql",
        "EXPO_PUBLIC_GRAPHQL_URL": "https://api.jodeearat.ru/graphql",
        "EXPO_PUBLIC_MEDIA_URL": "https://d70f44b5-2b00-4923-966f-5976c13a5f89.selstorage.ru",
        "EXPO_PUBLIC_WEBSOCKET_URL": "wss://api.jodeearat.ru/graphql"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.jodeearat.ru",
        "EXPO_PUBLIC_SERVER_URL": "https://api.jodeearat.ru/graphql",
        "EXPO_PUBLIC_GRAPHQL_URL": "https://api.jodeearat.ru/graphql",
        "EXPO_PUBLIC_MEDIA_URL": "https://d70f44b5-2b00-4923-966f-5976c13a5f89.selstorage.ru",
        "EXPO_PUBLIC_WEBSOCKET_URL": "wss://api.jodeearat.ru/graphql"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
