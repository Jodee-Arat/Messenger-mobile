{
  "name": "client",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "graphql-codegen --config graphql.config.ts && expo start",
    "start:go": "graphql-codegen --config graphql.config.ts && expo start --go --offline --clear",
    "start:go:tunnel": "graphql-codegen --config graphql.config.ts && expo start --go --tunnel --clear",
    "start:dev-client": "graphql-codegen --config graphql.config.ts && expo start --dev-client --offline --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:project:init": "npx eas-cli project:init",
    "ios:device:register": "npx eas-cli device:create",
    "ios:build:dev": "npx eas-cli build --platform ios --profile development",
    "web": "expo start --web",
    "test": "jest --forceExit",
    "test:watch": "jest --watch --forceExit"
  },
  "dependencies": {
    "@apollo/client": "3.13.8",
